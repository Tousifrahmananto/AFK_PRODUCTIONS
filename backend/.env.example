MONGO_URI=mongodb://127.0.0.1:27017/afk_productions
JWT_SECRET=replace-with-a-random-secret
PORT=5000
CLIENT_ORIGIN=http://localhost:3000

# Required for provisioning: generate once with node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Keep this key stable: changing it makes stored Google tokens and temporary copies unreadable.
INTEGRATION_ENCRYPTION_KEY=
# Optional private Sheets / Gmail connections; CSV imports do not require Google.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5000/api/google/callback
GOOGLE_PICKER_API_KEY=
GOOGLE_CLOUD_PROJECT_NUMBER=
